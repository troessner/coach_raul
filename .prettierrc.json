{
  "plugins": ["prettier-plugin-astro"],
  "useTabs": true,
  "singleQuote": true,
  "printWidth": 120,
  "overrides": [
    {
      "files": "*.astro",
      "options": { "parser": "astro" }
    },
    {
      "files": ["*.json", "*.md", "*.yml", "*.yaml"],
      "options": { "useTabs": false, "tabWidth": 2 }
    }
  ]
}
