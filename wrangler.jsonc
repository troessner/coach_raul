{
	// Source config only. The Cloudflare Vite plugin derives `main` and the
	// `assets` block from the Astro build and writes the real deploy config to
	// dist/server/wrangler.json — setting them here instead makes the plugin
	// resolve an entry point that does not exist until after the build.
	"name": "coach-raul",
	"compatibility_date": "2026-10-29",
	// The Sanity client reaches for node builtins.
	"compatibility_flags": ["nodejs_compat"],
}
