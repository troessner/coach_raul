---
import { Image } from 'astro:assets';
import { VisualEditing } from '@sanity/astro/visual-editing';
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import ServiceCard from '../components/ServiceCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Testimonial from '../components/Testimonial.astro';
import { operator, telHref, whatsAppHref } from '../legal';
import { DRAFT_COOKIE, getPageContent } from '../lib/sanity';
import heroPhoto from '../assets/hero.png';
import portrait from '../assets/raul-portrait.png';
import gymWeights from '../assets/gym-weights.png';

// Rendered per request, not at build time. That is what lets Raul hit Publish
// in the Studio and see it live without a deploy — the whole reason this page
// opts out of prerendering while the legal pages and the 404 do not.
export const prerender = false;

const preview = Astro.cookies.get(DRAFT_COOKIE)?.value === 'true';
const { settings, services, testimonials, socials } = await getPageContent(preview);

if (preview) {
	// Unpublished content must never be cached anywhere, by anyone.
	Astro.response.headers.set('Cache-Control', 'private, no-store');
} else {
	// Cached at Cloudflare's edge for a minute, so a burst of traffic is one
	// Sanity query rather than thousands. A publish therefore shows up within
	// ~60s; drop this to 0 if that is ever too slow, at the cost of a query per
	// page view.
	Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=600');
}

// The three images above stay local on purpose: they are design assets, not
// content. Raul never swaps them from the Studio, and routing them through
// Sanity would cost them the astro:assets optimisation they get for free here.
---

<Layout
	title="Coach Raul Payares — Get Stronger. Get Healthier."
	description="Personal training, nutrition and mindset coaching in Berlin. 15+ years helping people build a stronger body and a stronger mind."
>
	<header class="hero">
		<Image
			class="hero-photo"
			src={heroPhoto}
			alt="Coach Raul Payares training with a client"
			widths={[640, 1024, heroPhoto.width]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
		/>
		<div class="hero-overlay"></div>
		<div class="shell hero-content">
			<Logo />
			<div class="hero-copy">
				<h1 class="display hero-title">
					{settings.heroTitleLines.map((line, i) => (
						<Fragment>
							{i > 0 && <br />}
							{line}
						</Fragment>
					))}
				</h1>
				<p class="hero-sub">
					{settings.heroSubLines.map((line, i) => (
						<Fragment>
							{i > 0 && <br />}
							{line}
						</Fragment>
					))}
				</p>
				<a class="cta" href="#classes">
					{settings.heroCtaLabel}
				</a>
			</div>
		</div>
	</header>

	<main>
		<section class="shell about" id="about">
			<Image
				class="portrait"
				src={portrait}
				alt="Raul Payares"
				widths={[400, 800]}
				sizes="(max-width: 820px) 80vw, 340px"
			/>
			<div class="about-text">
				<h2 class="display section-heading about-heading">
					Meet
					<br />
					Coach Raul Payares
				</h2>
				<div class="bio">
					{settings.bioParagraphs.map((paragraph) => (
						<p>{paragraph}</p>
					))}
				</div>
			</div>
		</section>

		<section class="shell services" id="services">
			<h2 class="display section-heading services-heading">Service</h2>
			<div class="service-grid">
				{services.map((service) => (
					<ServiceCard {...service} />
				))}
			</div>
		</section>

		<section class="shell classes" id="classes">
			<h2 class="display section-heading">Group classes</h2>
			<p class="classes-body">
				Pick a time that suits you and book the slot — no account, no sign-up form. Booking opens in a new tab.
			</p>
			<a class="cta" href={settings.bookingUrl} rel="noopener noreferrer" target="_blank">
				See class times
			</a>
		</section>

		<section class="shell stories" id="stories">
			<h2 class="display section-heading">Success stories</h2>
			<div class="story-grid">
				{testimonials.map((testimonial) => (
					<Testimonial {...testimonial} />
				))}
			</div>
		</section>
	</main>

	<footer class="footer" id="contact">
		<Image
			class="footer-photo"
			src={gymWeights}
			alt=""
			widths={[800, 1280]}
			quality={60}
			sizes="100vw"
			aria-hidden="true"
		/>
		<div class="footer-overlay"></div>
		<div class="shell footer-content">
			<Logo color="accent" />
			<div class="footer-connect">
				<h2 class="display footer-heading">Stay connected</h2>
				<ul class="contact">
					<li>
						<a href={`mailto:${operator.email}`}>{operator.email}</a>
					</li>
					<li>
						<a href={telHref(operator.phone)}>{operator.phone}</a>
					</li>
					<li>
						<a href={whatsAppHref(operator.phone)} rel="noopener noreferrer" target="_blank">
							WhatsApp
						</a>
					</li>
				</ul>
				<SocialLinks links={socials} />
			</div>
			<nav class="legal" aria-label="Rechtliches">
				<a href="/impressum/">Impressum</a>
				<a href="/datenschutz/">Datenschutz</a>
			</nav>
		</div>
	</footer>
	{preview && <VisualEditing />}
</Layout>

<style>
	/* ---------- hero ---------- */
	.hero {
		position: relative;
		min-height: min(88vh, 760px);
		display: flex;
		align-items: stretch;
		overflow: hidden;
	}

	.hero-photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* Keeps both faces in frame; raise toward 50% to crop tighter on the torsos. */
		object-position: center 18%;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(100deg, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.35) 45%, rgba(0, 0, 0, 0.1) 100%);
	}

	.hero-content {
		position: relative;
		width: 100%;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 3rem;
		padding-block: clamp(1.75rem, 4vw, 2.75rem) clamp(2.5rem, 6vw, 4.5rem);
	}

	.hero-title {
		font-size: clamp(2.6rem, 8vw, 5.25rem);
	}

	.hero-sub {
		margin: 1.5rem 0 2.25rem;
		font-size: clamp(0.9rem, 2vw, 1.05rem);
		font-weight: 300;
		line-height: 1.6;
	}

	/* ---------- about ---------- */
	.about {
		display: grid;
		grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 5rem);
		padding-block: clamp(4rem, 11vw, 8rem);
	}

	.portrait {
		width: 100%;
		height: auto;
	}

	.about-heading {
		text-align: right;
	}

	.bio {
		margin-top: 2.25rem;
		max-width: 46ch;
		margin-left: auto;
		color: var(--accent);
		font-size: 0.82rem;
		line-height: 1.8;
	}

	.bio p {
		margin: 0 0 1rem;
	}

	/* ---------- services ---------- */
	.services {
		padding-block: clamp(3rem, 8vw, 6rem);
	}

	.services-heading {
		text-align: right;
		margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
	}

	.service-grid,
	.story-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(1.5rem, 3vw, 2.5rem);
		align-items: start;
	}

	/* ---------- classes ---------- */
	.classes {
		padding-block: clamp(3rem, 8vw, 6rem);
	}

	.classes h2 {
		margin-bottom: 1.5rem;
	}

	.classes-body {
		max-width: 46ch;
		margin: 0 0 2.25rem;
		color: var(--muted);
		font-size: 0.82rem;
		line-height: 1.75;
	}

	/* ---------- success stories ---------- */
	.stories {
		padding-block: clamp(3rem, 8vw, 6rem) clamp(5rem, 12vw, 9rem);
	}

	.stories h2 {
		margin-bottom: clamp(2.5rem, 6vw, 4rem);
	}

	/* ---------- footer ---------- */
	.footer {
		position: relative;
		min-height: min(70vh, 540px);
		display: flex;
		overflow: hidden;
	}

	.footer-photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.footer-overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.55);
	}

	.footer-content {
		position: relative;
		width: 100%;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 4rem;
		padding-block: clamp(2rem, 5vw, 3.5rem);
	}

	.contact {
		list-style: none;
		margin: 0 0 1.75rem;
		padding: 0;
		display: grid;
		gap: 0.45rem;
	}

	.contact a {
		text-decoration: none;
	}

	.contact a:hover {
		color: var(--accent);
	}

	.legal {
		display: flex;
		gap: 1.75rem;
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.legal a {
		text-decoration: none;
	}

	.legal a:hover {
		color: var(--accent);
	}

	.footer-heading {
		font-size: clamp(1.5rem, 3.5vw, 2.1rem);
		color: var(--accent);
		margin-bottom: 1.25rem;
	}

	/* ---------- responsive ---------- */
	@media (max-width: 860px) {
		.about {
			grid-template-columns: minmax(0, 1fr);
		}

		.portrait {
			max-width: 320px;
		}

		.about-heading,
		.services-heading {
			text-align: left;
		}

		.bio {
			margin-left: 0;
		}

		.service-grid,
		.story-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 2.5rem;
		}
	}

	@media (max-width: 520px) {
		.service-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
