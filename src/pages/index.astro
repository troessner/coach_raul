---
import { Image } from 'astro:assets';
import { VisualEditing } from '@sanity/astro/visual-editing';
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import ServiceCard from '../components/ServiceCard.astro';
import SiteNav from '../components/SiteNav.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Testimonial from '../components/Testimonial.astro';
import { telHref, whatsAppHref } from '../legal';
import { CONTENT_CACHE, setPageHeaders } from '../lib/headers';
import { renderRichText } from '../lib/richText';
import { DRAFT_COOKIE, getPageContent, imageUrl } from '../lib/sanity';
import gymWeights from '../assets/gym-weights.png';

// Rendered per request, not at build time. That is what lets Raul hit Publish
// in the Studio and see it live without a deploy — the whole reason this page
// opts out of prerendering. The legal pages do the same for the same reason;
// only the 404 is still a static file.
export const prerender = false;

const preview = Astro.cookies.get(DRAFT_COOKIE)?.value === 'true';
const { settings, operator, services, testimonials, socials } = await getPageContent(preview);

setPageHeaders(Astro.response.headers, preview, CONTENT_CACHE);

// The footer photo above stays local on purpose: it is a design asset, not
// content. Raul never swaps it from the Studio, and routing it through Sanity
// would cost it the astro:assets optimisation it gets for free here. The hero
// and the bio portrait are the photos he is expected to change, so they come
// from the CMS and are served by Sanity's CDN instead.
// Capped at 1600: Sanity's `fit: max` never upscales, so a wider entry would
// advertise a width the asset cannot deliver and the browser would pick it
// believing it is larger. The current hero is 1285px on its long edge.
const heroSrc = imageUrl(settings.heroImage, 1600);
const heroSrcset = [640, 1024, 1600].map((w) => `${imageUrl(settings.heroImage, w)} ${w}w`).join(', ');

/**
 * The jump links in the hero. `id` has to match a section's id on this page —
 * tests/home-page.test.ts asserts every one of them resolves, because a nav
 * entry pointing at a section that was renamed is a link that silently does
 * nothing.
 *
 * Labels are short on purpose and separate from the section headings in the
 * CMS: "Stories" reads better here than "Success stories", and tying the two
 * together would mean one cannot change without the other.
 */
const SECTIONS = [
	{ id: 'about', label: 'About' },
	{ id: 'services', label: 'Services' },
	{ id: 'classes', label: 'Classes' },
	{ id: 'stories', label: 'Stories' },
	{ id: 'contact', label: 'Contact' },
] as const;

const portraitSrc = imageUrl(settings.portraitImage, 680);
const portraitSrcset = [400, 680, 900].map((w) => `${imageUrl(settings.portraitImage, w)} ${w}w`).join(', ');
---

<Layout
	title="Coach Raul Payares — Get Stronger. Get Healthier."
	description="Personal training, nutrition and mindset coaching in Berlin. 15+ years helping people build a stronger body and a stronger mind."
>
	<header class="hero">
		<!-- No width/height: .hero-photo is absolutely positioned and fills the
		     header, so there is no layout for an intrinsic size to shift. The
		     overlay and the copy sit on the background colour without it. -->
		{heroSrc && (
			<img
				class="hero-photo"
				src={heroSrc}
				srcset={heroSrcset}
				sizes="100vw"
				alt={settings.heroImage?.alt ?? ''}
				loading="eager"
				fetchpriority="high"
			/>
		)}
		<div class="hero-overlay"></div>
		<div class="shell hero-content">
			<div class="hero-top">
				<Logo />
				<SiteNav sections={SECTIONS} />
			</div>
			<div class="hero-copy">
				<h1 class="display hero-title">
					{settings.heroTitleLines.map((line, i) => (
						<Fragment>
							{i > 0 && <br />}
							{line}
						</Fragment>
					))}
				</h1>
				<p class="hero-sub">
					{settings.heroSubLines.map((line, i) => (
						<Fragment>
							{i > 0 && <br />}
							{line}
						</Fragment>
					))}
				</p>
				<a class="cta" href="#classes">
					{settings.heroCtaLabel}
				</a>
			</div>
		</div>
	</header>

	<main>
		<section class="shell about" id="about">
			{portraitSrc && (
				<img
					class="portrait"
					src={portraitSrc}
					srcset={portraitSrcset}
					sizes="(max-width: 860px) 80vw, 340px"
					alt={settings.portraitImage?.alt ?? ''}
					width="340"
					height="453"
					loading="lazy"
					decoding="async"
				/>
			)}
			<div class="about-text">
				<h2 class="display section-heading about-heading">
					{settings.aboutHeadingLines.map((line, i) => (
						<Fragment>
							{i > 0 && <br />}
							{line}
						</Fragment>
					))}
				</h2>
				<!-- set:html, because the bio is rendered Portable Text rather than a
				     list of strings. renderRichText escapes the text it emits. -->
				<div class="bio" set:html={renderRichText(settings.bioParagraphs)} />
			</div>
		</section>

		<section class="shell services" id="services">
			<h2 class="display section-heading services-heading">{settings.servicesHeading}</h2>
			<div class="service-grid">
				{services.map((service) => (
					<ServiceCard {...service} />
				))}
			</div>
		</section>

		<section class="shell classes" id="classes">
			<h2 class="display section-heading">{settings.classesHeading}</h2>
			<p class="classes-body">
				Pick a time that suits you and book the slot — no account, no sign-up form. Booking opens in a new tab.
			</p>
			<a class="cta" href={settings.bookingUrl} rel="noopener noreferrer" target="_blank">
				Book a class
			</a>
		</section>

		<section class="shell stories" id="stories">
			<h2 class="display section-heading">{settings.storiesHeading}</h2>
			<div class="story-grid">
				{testimonials.map((testimonial) => (
					<Testimonial {...testimonial} />
				))}
			</div>
		</section>
	</main>

	<footer class="footer" id="contact">
		<Image
			class="footer-photo"
			src={gymWeights}
			alt=""
			widths={[800, 1280]}
			quality={60}
			sizes="100vw"
			aria-hidden="true"
		/>
		<div class="footer-overlay"></div>
		<div class="shell footer-content">
			<Logo color="accent" />
			<div class="footer-connect">
				<h2 class="display footer-heading">{settings.connectHeading}</h2>
				<ul class="contact">
					<li>
						<a href={`mailto:${operator.email}`}>{operator.email}</a>
					</li>
					<li>
						<a href={telHref(operator.phone)}>{operator.phone}</a>
					</li>
					<li>
						<a href={whatsAppHref(operator.phone)} rel="noopener noreferrer" target="_blank">
							WhatsApp
						</a>
					</li>
				</ul>
				<SocialLinks links={socials} />
			</div>
			<nav class="legal" aria-label="Rechtliches">
				<a href="/impressum/">Impressum</a>
				<a href="/datenschutz/">Datenschutz</a>
			</nav>
		</div>
	</footer>
	{preview && (
		<div class="preview-bar">
			<span>
				<strong>Preview</strong> — unpublished drafts. This is not what visitors see.
			</span>
			<a href="/api/draft/disable">Exit preview</a>
		</div>
	)}
	<VisualEditing enabled={preview} />
</Layout>

<style>
	/* ---------- preview bar ---------- */
	/* The draft cookie is httpOnly and lives on the site's own origin for an
	   hour, so a preview session is otherwise invisible outside the Studio and
	   drafts get mistaken for the live site. Fixed rather than static: it must
	   not shift the layout it is there to let you judge. */
	.preview-bar {
		position: fixed;
		inset: 0 0 auto;
		z-index: 100;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.25rem 1rem;
		padding: 0.5rem var(--gutter);
		background: var(--accent);
		color: #000;
		font-size: 0.875rem;
	}

	.preview-bar a {
		font-weight: 700;
		text-decoration: underline;
	}

	/* The global focus ring is --accent, which is this bar's background. */
	.preview-bar a:focus-visible {
		outline: 2px solid #000;
		outline-offset: 2px;
	}

	/* ---------- hero ---------- */
	.hero {
		position: relative;
		min-height: min(88vh, 760px);
		display: flex;
		align-items: stretch;
		overflow: hidden;
	}

	.hero-photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* Keeps both faces in frame; raise toward 50% to crop tighter on the torsos. */
		object-position: center 18%;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(100deg, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.35) 45%, rgba(0, 0, 0, 0.1) 100%);
	}

	.hero-content {
		position: relative;
		width: 100%;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 3rem;
		padding-block: clamp(1.75rem, 4vw, 2.75rem) clamp(2.5rem, 6vw, 4.5rem);
	}

	.hero-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: clamp(1.5rem, 4vw, 3rem);
		flex-wrap: wrap;
	}

	.hero-title {
		font-size: clamp(2.6rem, 8vw, 5.25rem);
	}

	.hero-sub {
		margin: 1.5rem 0 2.25rem;
		font-size: clamp(0.9rem, 2vw, 1.05rem);
		font-weight: 300;
		line-height: 1.6;
	}

	/* ---------- about ---------- */
	.about {
		display: grid;
		grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 5rem);
		padding-block: clamp(4rem, 11vw, 8rem);
	}

	.portrait {
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 4;
		object-fit: cover;
	}

	.about-heading {
		text-align: right;
	}

	.bio {
		margin-top: 2.25rem;
		max-width: 46ch;
		margin-left: auto;
		color: var(--accent);
		font-size: 0.82rem;
		line-height: 1.8;
	}

	/* :global, because scoped styles are applied at compile time and this markup
	   arrives through set:html with no scope attribute on it. */
	.bio :global(.rt-highlight) {
		color: var(--fg);
	}

	.bio :global(a) {
		color: var(--fg);
	}

	.bio p {
		margin: 0 0 1rem;
	}

	/* ---------- services ---------- */
	.services {
		padding-block: clamp(3rem, 8vw, 6rem);
	}

	.services-heading {
		text-align: right;
		margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
	}

	.service-grid,
	.story-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(1.5rem, 3vw, 2.5rem);
		align-items: start;
	}

	/* Two up rather than four: a story is a paragraph of prose, and at a quarter
	   of the shell it wraps every four or five words. The wider gap keeps the
	   two columns reading as separate stories rather than one block of text. */
	.story-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(2rem, 5vw, 4rem);
	}

	/* ---------- classes ---------- */
	.classes {
		padding-block: clamp(3rem, 8vw, 6rem);
	}

	.classes h2 {
		margin-bottom: 1.5rem;
	}

	.classes-body {
		max-width: 46ch;
		margin: 0 0 2.25rem;
		color: var(--muted);
		font-size: 0.82rem;
		line-height: 1.75;
	}

	/* ---------- success stories ---------- */
	.stories {
		padding-block: clamp(3rem, 8vw, 6rem) clamp(5rem, 12vw, 9rem);
	}

	.stories h2 {
		margin-bottom: clamp(2.5rem, 6vw, 4rem);
	}

	/* ---------- footer ---------- */
	.footer {
		position: relative;
		min-height: min(70vh, 540px);
		display: flex;
		overflow: hidden;
	}

	.footer-photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.footer-overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.55);
	}

	.footer-content {
		position: relative;
		width: 100%;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 4rem;
		padding-block: clamp(2rem, 5vw, 3.5rem);
	}

	.contact {
		list-style: none;
		margin: 0 0 1.75rem;
		padding: 0;
		display: grid;
		gap: 0.45rem;
	}

	.contact a {
		text-decoration: none;
	}

	.contact a:hover {
		color: var(--accent);
	}

	.legal {
		display: flex;
		gap: 1.75rem;
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.legal a {
		text-decoration: none;
	}

	.legal a:hover {
		color: var(--accent);
	}

	.footer-heading {
		font-size: clamp(1.5rem, 3.5vw, 2.1rem);
		color: var(--accent);
		margin-bottom: 1.25rem;
	}

	/* ---------- responsive ---------- */
	@media (max-width: 860px) {
		.about {
			grid-template-columns: minmax(0, 1fr);
		}

		.portrait {
			max-width: 320px;
		}

		.about-heading,
		.services-heading {
			text-align: left;
		}

		.bio {
			margin-left: 0;
		}

		.service-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 2.5rem;
		}
	}

	@media (max-width: 520px) {
		.service-grid,
		.story-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
