---
import { imageUrl } from '../lib/sanity';
import type { Testimonial } from '../lib/sanity';

type Props = Testimonial;

const { quote, name, photo } = Astro.props;

// Sanity's CDN does the resizing and the webp negotiation, so these bypass
// astro:assets entirely — running both would download every image at build
// time to re-encode what is already encoded.
const src = imageUrl(photo, 480);
const srcset = [320, 480, 640].map((w) => `${imageUrl(photo, w)} ${w}w`).join(', ');
---

<figure class="testimonial">
	<img
		class="photo"
		src={src}
		srcset={srcset}
		sizes="(max-width: 700px) 45vw, 260px"
		alt={photo.alt}
		width="320"
		height="480"
		loading="lazy"
		decoding="async"
	/>
	<blockquote class="quote">{quote}</blockquote>
	<figcaption class="name">{name}</figcaption>
</figure>

<style>
	.testimonial {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.photo {
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		filter: grayscale(1);
	}

	.quote {
		margin: 0;
		color: var(--muted);
		font-size: 0.8rem;
		line-height: 1.75;
	}

	.quote::before {
		content: '\201C';
	}

	.quote::after {
		content: '\201D';
	}

	.name {
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
</style>
