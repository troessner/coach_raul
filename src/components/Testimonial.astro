---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	quote: string;
	name: string;
	photo: ImageMetadata;
}

const { quote, name, photo } = Astro.props;
---

<figure class="testimonial">
	<Image class="photo" src={photo} alt={name} widths={[320, 480]} sizes="(max-width: 700px) 45vw, 260px" />
	<blockquote class="quote">{quote}</blockquote>
	<figcaption class="name">{name}</figcaption>
</figure>

<style>
	.testimonial {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.photo {
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		filter: grayscale(1);
	}

	.quote {
		margin: 0;
		color: var(--muted);
		font-size: 0.8rem;
		line-height: 1.75;
	}

	.quote::before {
		content: '\201C';
	}

	.quote::after {
		content: '\201D';
	}

	.name {
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
</style>
