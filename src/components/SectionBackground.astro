---
import type { SanityImageSource } from '@sanity/image-url';
import { imageUrl } from '../lib/sanity';

interface Props {
	/** Optional. Nothing renders without one, leaving the section on --bg. */
	image?: SanityImageSource | null;
}

const { image } = Astro.props;

// Capped at 1600 for the same reason as the hero: `fit: max` never upscales, so
// a wider candidate would advertise a width the asset cannot deliver.
const src = imageUrl(image, 1600);
const srcset = [800, 1280, 1600].map((w) => `${imageUrl(image, w)} ${w}w`).join(', ');
---

{src && (
	<>
		{/* Decorative: it carries no information the text does not already give,
			    so it is hidden from assistive technology rather than described. */}
		<img
			class="section-photo"
			src={src}
			srcset={srcset}
			sizes="100vw"
			alt=""
			aria-hidden="true"
			loading="lazy"
			decoding="async"
		/>
		<div class="section-scrim" aria-hidden="true" />
	</>
)}

<style>
	.section-photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/*
	 * 0.8 is not a taste decision, it is the weakest scrim that still clears
	 * 4.5:1 for the dimmest text on the page over the brightest possible photo.
	 *
	 * --muted (#9d9d9d) on a white photo at opacity a sits on rgb(255(1-a)).
	 * Solving for 4.5:1 gives a = 0.79, so 0.8 with a little margin. Weaken it
	 * and the story quotes stop being readable on a light background; the photo
	 * is meant to be texture under the type, not competition for it.
	 */
	.section-scrim {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.8);
	}
</style>
