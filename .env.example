# Sanity CMS.
#
# Get these by running, once, from the repo root:
#   npx sanity@latest init
#
# PUBLIC_ because the Studio runs in the browser at /studio and needs them
# there. Neither is a secret — a project id identifies a public dataset and
# cannot be used to write anything.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Read token with "Viewer" rights, from https://sanity.io/manage -> API -> Tokens.
#
# This one IS a secret: it reads unpublished drafts. It is only ever used on the
# server, in the two /api/draft routes and in preview rendering, and must be set
# as an encrypted secret in Cloudflare (`npx wrangler secret put SANITY_READ_TOKEN`)
# rather than as a plain build variable.
SANITY_READ_TOKEN=

# Write token, Editor rights. Only needed once, by scripts/seed-sanity.mjs.
# Revoke it after the seed has run; nothing else reads it.
SANITY_WRITE_TOKEN=
