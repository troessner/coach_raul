# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# wrangler / miniflare local state, written by builds and `astro dev`
.wrangler/

# scratch files (PR bodies, commit messages) written by the publish/amend skills
tmp/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
# .env.* rather than two named files: an editor swap file (.env.swp) holds the
# same secrets as the file it is editing, and `git add -A` would have staged
# one. .env.example is the one that must stay tracked.
.env
.env.*
!.env.example

# editor swap/backup files, wherever they land
*.swp
*.swo
*~

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
